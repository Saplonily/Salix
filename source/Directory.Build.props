<Project>
  <PropertyGroup>
    <RootNamespace>Saladim.Salix</RootNamespace>
    
    <SlxTargetFrameworks Condition="'$(Configuration)' == 'Release'">netstandard2.0;netstandard2.1;net6.0;net7.0;net8.0</SlxTargetFrameworks>
    <SlxTargetFrameworks Condition="'$(Configuration)' == 'Debug'">netstandard2.0;netstandard2.1;net8.0</SlxTargetFrameworks>
    <SlxTestTargetFrameworks>net472;net481;net6.0;net7.0;net8.0</SlxTestTargetFrameworks>

    <Features>strict</Features>
    <LangVersion>preview</LangVersion>

    <PathMap Condition="'$(SolutionDir)'==''">$(MSBuildProjectDirectory)=~/$(MSBuildProjectName)</PathMap>
    <PathMap Condition="'$(SolutionDir)'!=''">$(SolutionDir)=/</PathMap>

    <!-- wait a minute, not now
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>all</AnalysisMode>-->

    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
  </PropertyGroup>
</Project>